{
	"name": "maikschneider/login-color-scheme",
	"description": "Color-scheme aware TYPO3 backend login: adds a dark mode variant for the login background image.",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"typo3",
		"typo3-cms-extension",
		"backend",
		"login",
		"dark-mode",
		"color-scheme"
	],
	"authors": [
		{
			"name": "Maik Schneider",
			"email": "schneider.maik@me.com",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/maikschneider/login-color-scheme/issues",
		"source": "https://github.com/maikschneider/login-color-scheme"
	},
	"require": {
		"php": "^8.2",
		"psr/http-message": "^1.1 || ^2.0",
		"psr/http-server-handler": "^1.0",
		"psr/http-server-middleware": "^1.0",
		"typo3/cms-backend": "^13.4 || ^14.0",
		"typo3/cms-core": "^13.4 || ^14.0"
	},
	"require-dev": {
		"armin/editorconfig-cli": "^2.1",
		"ergebnis/composer-normalize": "^2.45",
		"friendsofphp/php-cs-fixer": "^3.12",
		"move-elevator/composer-translation-validator": "^1.3",
		"phpstan/extension-installer": "^1.3",
		"phpunit/phpunit": "^11.5 || ^12.0",
		"saschaegerer/phpstan-typo3": "^3.0",
		"typo3/testing-framework": "^9.5"
	},
	"autoload": {
		"psr-4": {
			"MaikSchneider\\LoginColorScheme\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"MaikSchneider\\LoginColorScheme\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"move-elevator/composer-translation-validator": true,
			"phpstan/extension-installer": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"lock": false
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "login_color_scheme"
		}
	},
	"scripts": {
		"ci:composer:normalize": "@composer normalize --no-check-lock --dry-run",
		"ci:editorconfig:lint": "ec --strict --git-only -n",
		"ci:language:lint": "composer validate-translations Resources/Private/Language",
		"ci:php:fixer": "php-cs-fixer --config=php-cs-fixer.php fix --dry-run --format=checkstyle > php-cs-fixer.xml || true",
		"ci:php:lint": "find *.php Classes Configuration Tests -name '*.php' -print0 | xargs -0 -n 1 -P 4 php -l",
		"ci:php:stan": "phpstan --no-progress --error-format=checkstyle > phpstan.xml || true",
		"ci:sca": [
			"@ci:composer:normalize",
			"@ci:editorconfig:lint",
			"@ci:php:lint",
			"@ci:php:fixer",
			"@ci:php:stan",
			"@ci:language:lint"
		],
		"ci:tests": "@ci:tests:unit",
		"ci:tests:unit": "phpunit --testsuite Unit --do-not-cache-result",
		"composer:normalize": "@composer normalize --no-check-lock",
		"editorconfig:lint": "ec --strict --fix --git-only -n",
		"language:lint": "composer validate-translations Resources/Private/Language",
		"php:fixer": "php-cs-fixer --config=php-cs-fixer.php fix",
		"php:lint": "find *.php Classes Configuration Tests -name '*.php' -print0 | xargs -0 -n 1 -P 4 php -l",
		"php:stan": "phpstan --no-progress",
		"sca": [
			"@composer:normalize",
			"@editorconfig:lint",
			"@php:lint",
			"@php:fixer",
			"@php:stan",
			"@language:lint"
		],
		"tests": "@tests:unit",
		"tests:unit": "phpunit --testsuite Unit"
	}
}
